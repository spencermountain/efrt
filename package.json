{
  "name": "efrt",
  "version": "2.7.0",
  "description": "neato compression of key-value data",
  "license": "MIT",
  "repository": "github:spencermountain/efrt",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "exports": {
    ".": {
      "require": "./builds/efrt.cjs",
      "import": "./src/index.js",
      "default": "./builds/efrt.cjs"
    },
    "./unpack": {
      "import": "./src/unpack/index.js",
      "default": "./builds/efrt-unpack.min.js"
    }
  },
  "main": "./src/index.js",
  "sideEffects": false,
  "engines": {
    "node": ">=12.0.0"
  },
  "scripts": {
    "build": "node ./scripts/version.js && rollup -c ",
    "test": "tape \"./tests/*.test.js\" | tap-dancer",
    "testb": "TESTENV=prod tape \"./tests/*.test.js\" | tap-dancer",
    "watch": "node --watch ./scratch",
    "lint": "eslint ."
  },
  "files": [
    "builds/",
    "src/"
  ],
  "dependencies": {
    "eslint": "^10.11.0"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "4.63.4",
    "rollup-plugin-filesize-check": "2.0.1",
    "tap-dancer": "0.4.2",
    "tape": "5.10.2"
  },
  "unpkg": "./builds/efrt.min.js",
  "prettier": {
    "trailingComma": "none",
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  }
}
