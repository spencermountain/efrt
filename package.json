{
  "name": "efrt",
  "version": "2.8.0",
  "description": "neato compression of key-value data",
  "license": "MIT",
  "repository": "github:spencermountain/efrt",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "exports": {
    ".": {
      "require": "./builds/efrt.cjs",
      "import": "./src/index.js",
      "default": "./builds/efrt.cjs"
    },
    "./unpack": {
      "require": "./builds/efrt-unpack.cjs",
      "import": "./src/unpack/index.js",
      "default": "./builds/efrt-unpack.cjs"
    }
  },
  "main": "./src/index.js",
  "sideEffects": false,
  "engines": {
    "node": ">=12.0.0"
  },
  "scripts": {
    "build": "node ./scripts/version.js && rollup -c ",
    "test": "tape \"./tests/*.test.js\" | tap-dancer",
    "testb": "node scripts/test-build.js | tap-dancer",
    "test:package": "node scripts/test-package.js",
    "verify": "npm run build && npm run lint && npm test && npm run testb && npm run test:package",
    "watch": "node --watch ./scratch",
    "lint": "eslint ."
  },
  "files": [
    "builds/",
    "src/"
  ],
  "devDependencies": {
    "@rollup/plugin-terser": "1.0.0",
    "eslint": "10.11.0",
    "rollup": "4.63.4",
    "rollup-plugin-filesize-check": "2.0.1",
    "tape": "5.10.2"
  },
  "unpkg": "./builds/efrt.min.js",
  "prettier": {
    "trailingComma": "none",
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  }
}
